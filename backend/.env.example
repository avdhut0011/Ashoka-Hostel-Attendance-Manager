# APPLICATION ENVIRONMENT
APP_ENV=development
PROJECT_NAME=Hostel Attendance Management System

# SOURCE IT MS SQL DATABASE (READ ONLY)
SOURCE_DB_HOST=192.168.1.100
SOURCE_DB_PORT=1433
SOURCE_DB_NAME=ePushDB
SOURCE_DB_USER=epush_readonly
SOURCE_DB_PASSWORD=SecurePassword123!
SOURCE_TABLE=DeviceLogs

# TARGET HOSTEL ATTENDANCE MS SQL DATABASE
TARGET_DB_HOST=localhost
TARGET_DB_PORT=1433
TARGET_DB_NAME=HostelAttendance
TARGET_DB_USER=hostel_admin
TARGET_DB_PASSWORD=TargetDBPassword123!

# BUSINESS RULE PARAMETERS
SYNC_INTERVAL_SECONDS=10
DUPLICATE_WINDOW_SECONDS=45

# JWT & SECURITY
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

APP_TIMEZONE=Asia/Kolkata
SOURCE_TIMEZONE=Asia/Kolkata
SYNC_STALE_SECONDS=120
